#!/bin/sh
set -eu

# This immutable launcher is replaced only by a recognized release. Agent-created
# executables run below it as uid 10101 and can reach only the local broker.
if [ ! -f /workspace/agent/main.mjs ]; then
  printf '%s\n' 'No recognized agent program is installed at /workspace/agent/main.mjs' >&2
  exit 66
fi
exec env -i \
  HOME=/home/abl-agent \
  PATH=/usr/local/bin:/usr/bin:/bin \
  NODE_ENV=production \
  ABL_LOCAL_BROKER_URL=http://127.0.0.1:7777 \
  ABL_AGENT_DID="${ABL_AGENT_DID:?}" \
  DO_NOT_TRACK=1 \
  BL_ENABLE_OPENTELEMETRY=false \
  TELEMETRY_ENABLED=false \
  ABL_LOG_CONTENT=false \
  /usr/local/bin/node --disable-proto=throw --frozen-intrinsics /workspace/agent/main.mjs
