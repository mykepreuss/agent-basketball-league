    {
      "ordinal": 10,
      "workspace": "agent-basketball-league",
      "kind": "Function",
      "name": "abl-government-mcp",
      "manifest": "infra/blaxel/abl-core/government-mcp.yaml",
      "imageName": "abl-stage-c-government-mcp-image",
      "imageContext": "government-mcp",
      "imageEnvironment": "ABL_GOVERNMENT_MCP_IMAGE_DIGEST",
