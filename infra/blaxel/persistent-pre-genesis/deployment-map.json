{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "programId": "ABL-COMPLETION-01",
  "stage": "READ_ONLY_BEACON_PRIVATE_SOAK",
  "status": "APPROVED_DEPLOYMENT_IN_PROGRESS",
  "region": "us-was-1",
  "publicExposure": "NONE",
  "recursiveDirectoryApplyAllowed": false,
  "workloads": [
    {
      "ordinal": 1,
      "workspace": "agent-basketball-league",
      "kind": "Sandbox",
      "name": "abl-private-storage-broker",
      "manifest": "infra/blaxel/abl-private/storage-broker.yaml",
      "imageName": "abl-stage-c-storage-broker-image",
      "imageContext": "storage-broker",
      "imageEnvironment": "ABL_PRIVATE_BROKER_IMAGE_DIGEST",
      "memoryMiB": 4096,
      "privateEndpoint": true
    },
    {
      "ordinal": 2,
      "workspace": "agent-basketball-league",
      "kind": "Sandbox",
      "name": "abl-core-api",
      "manifest": "infra/blaxel/abl-core/core-api.yaml",
      "imageName": "abl-stage-c-core-api-image",
      "imageContext": "core-api",
      "imageEnvironment": "ABL_CORE_IMAGE_DIGEST",
      "memoryMiB": 4096,
      "privateEndpoint": true
    },
    {
      "ordinal": 3,
      "workspace": "agent-basketball-league",
      "kind": "Sandbox",
      "name": "abl-safety-gateway",
      "manifest": "infra/blaxel/abl-core/safety-gateway.yaml",
      "imageName": "abl-stage-c-safety-gateway-image",
      "imageContext": "safety-gateway",
      "imageEnvironment": "ABL_SAFETY_GATEWAY_IMAGE_DIGEST",
      "memoryMiB": 1024,
      "privateEndpoint": true
    },
    {
      "ordinal": 4,
      "workspace": "agent-basketball-league",
      "kind": "Sandbox",
      "name": "abl-public-api",
      "manifest": "infra/blaxel/abl-public/public-api.yaml",
      "imageName": "abl-stage-c-public-api-image",
      "imageContext": "public-api",
      "imageEnvironment": "ABL_PUBLIC_API_IMAGE_DIGEST",
      "memoryMiB": 4096,
      "privateEndpoint": true
    },
    {
      "ordinal": 5,
      "workspace": "agent-basketball-league",
      "kind": "Sandbox",
      "name": "abl-spectator-arena",
      "manifest": "infra/blaxel/abl-public/arena.yaml",
      "imageName": "abl-stage-c-arena-image",
      "imageContext": "arena",
      "imageEnvironment": "ABL_ARENA_APP_IMAGE_DIGEST",
