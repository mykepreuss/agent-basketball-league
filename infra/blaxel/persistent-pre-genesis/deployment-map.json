    {
      "ordinal": 12,
      "workspace": "agent-basketball-league",
      "kind": "Job",
      "name": "abl-candidate-provisioner",
      "manifest": "infra/blaxel/persistent-pre-genesis/manifests/candidate-provisioner.yaml",
      "imageName": "abl-stage-c-candidate-provisioner-image",
      "imageContext": "candidate-provisioner",
      "imageEnvironment": "ABL_CANDIDATE_PROVISIONER_IMAGE_DIGEST",
      "memoryMiB": 2048,
      "privateEndpoint": false
    },
    {
      "ordinal": 13,
      "workspace": "agent-basketball-league",
      "kind": "Job",
      "name": "abl-recovery-verifier",
      "manifest": "infra/blaxel/abl-core/recovery-job.yaml",
      "imageName": "abl-stage-c-recovery-job-image",
      "imageContext": "recovery-job",
      "imageEnvironment": "ABL_RECOVERY_JOB_IMAGE_DIGEST",
      "memoryMiB": 4096,
      "privateEndpoint": false
    }
  ],
  "prohibitions": [
    "directory-recursive apply",
    "example manifests",
    "model manifests",
    "mutable image tags",
    "public endpoints before Stage D",
    "career body before an actual admission",
    "fixed broker before an actual admission"
  ]
}
