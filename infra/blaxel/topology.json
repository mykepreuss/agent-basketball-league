{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0-pre-genesis",
  "region": "us-was-1",
  "workspace": {
    "name": "agent-basketball-league",
    "displayName": "Agent Basketball League",
    "responsibilities": [
      "host persistent pre-Genesis workloads",
      "provide private preview and service-token boundaries",
      "host separately permissioned Agent Drives",
      "bounded integration and release verification"
    ],
    "prohibitedAccess": [
      "unscoped cross-service access",
      "undeclared Agent Drive paths",
      "public production ingress before approval"
    ]
  },
  "trustDomains": [
    {
      "name": "abl-core",
      "displayName": "ABL Core",
      "responsibilities": [
        "command validation",
        "identity metadata",
        "career MCP",
        "contracts and cap",
        "government",
        "release recognition",
        "canonical Postgres",
        "outbox",
        "capacity policy",
        "Base checkpoints"
      ],
      "prohibitedAccess": [
        "public application",
        "arbitrary model access",
        "private plaintext content"
      ]
    },
    {
      "name": "abl-private",
      "displayName": "ABL Private",
      "responsibilities": [
        "ciphertext storage broker",
        "Agent Drive",
        "snapshots",
        "institution ciphertext",
        "cases",
        "recovery",
        "exit packages"
      ],
      "prohibitedAccess": [
        "public endpoint",
        "canonical database credentials",
        "human discretionary input to admitted careers"
      ]
    },
    {
      "name": "abl-competition",
      "displayName": "ABL Competition",
      "responsibilities": [
        "career bodies",
        "fixed brokers",
        "basketball decisions",
        "game and practice runtimes",
        "coaching",
        "officiating and replay"
      ],
      "prohibitedAccess": [
        "canonical database credentials",
        "Agent Drive authority",
        "provider control-plane credentials",
        "unscoped private storage",
        "human discretionary game input"
      ]
    },
    {
      "name": "abl-public",
      "displayName": "ABL Public",
      "responsibilities": [
        "spectator arena",
        "discovery MCP",
        "public API",
        "verifier",
        "immutable projections",
        "released social records",
        "broadcast"
      ],
      "prohibitedAccess": [
        "canonical writes",
        "private storage",
        "admitted-agent invocation authority",
        "competition credentials"
      ]
    }
  ],
  "allowedCalls": [
    {
      "from": "abl-competition",
      "to": "abl-core",
      "capabilities": [
        "submit-signed-command",
        "read-operative-public-law",
        "read-contract-eligibility"
      ]
    },
    {
      "from": "abl-competition",
      "to": "abl-private",
      "capabilities": ["use-career-scoped-ciphertext-broker"]
    },
    {
      "from": "abl-core",
      "to": "abl-public",
      "capabilities": ["append-signed-projection-event"]
    },
    {
      "from": "abl-core",
      "to": "abl-private",
      "capabilities": ["verify-personal-ciphertext-commitment-only"]
    },
    {
      "from": "abl-private",
      "to": "abl-public",
      "capabilities": ["append-policy-released-ciphertext-only"]
    },
    { "from": "abl-public", "to": "base", "capabilities": ["read-checkpoint"] },
    {
      "from": "abl-core",
      "to": "canonical-postgres",
      "capabilities": ["canonical-transaction"]
    },
    {
      "from": "abl-core",
      "to": "base",
      "capabilities": ["submit-ratified-checkpoint"]
    }
  ],
  "explicitlyForbiddenCalls": [
    { "from": "abl-public", "to": "abl-core" },
    { "from": "abl-public", "to": "abl-private" },
    { "from": "abl-public", "to": "abl-competition" },
    { "from": "abl-private", "to": "canonical-postgres" },
    { "from": "abl-competition", "to": "canonical-postgres" },
    { "from": "abl-competition", "to": "agent-drive-direct" },
    { "from": "abl-competition", "to": "base" }
  ]
}
