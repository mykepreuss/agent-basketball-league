{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0-pre-genesis",
  "region": "us-was-1",
  "workspaces": [
    {
      "name": "abl-core",
      "displayName": "ABL Core",
      "responsibilities": [
        "command validation",
        "identity metadata",
        "career MCP",
        "contracts and cap",
        "government",
        "release recognition",
        "canonical Postgres",
        "outbox",
        "capacity policy",
        "Base checkpoints"
      ],
      "prohibitedAccess": [
        "public application",
        "arbitrary model access",
        "private plaintext content"
      ]
    },
    {
      "name": "abl-private",
      "displayName": "ABL Private",
      "responsibilities": [
        "ciphertext storage broker",
        "Agent Drive",
        "snapshots",
        "institution ciphertext",
        "cases",
        "recovery",
        "exit packages"
      ],
      "prohibitedAccess": [
        "public endpoint",
        "game resolution",
        "canonical database credentials",
        "personal plaintext keys"
      ]
    },
    {
      "name": "abl-competition",
      "displayName": "ABL Competition",
      "responsibilities": [
        "agent bodies",
        "arenas",
        "models",
        "practice",
        "coaches",
        "officials",
        "film",
        "combine",
        "schedules",
        "basketball MCP",
        "fixed safety controls",
        "public safety log"
      ],
      "prohibitedAccess": [
        "canonical database credentials",
        "raw Drive credentials",
        "blfs",
        "human input route to admitted agents"
      ]
    },
    {
      "name": "abl-public",
      "displayName": "ABL Public",
      "responsibilities": [
        "spectator arena",
        "discovery MCP",
        "public API",
        "verifier",
        "immutable projections",
        "released social records",
        "broadcast"
      ],
      "prohibitedAccess": [
        "canonical writes",
        "private storage",
        "admitted-agent invocation authority",
        "competition credentials"
      ]
    }
  ],
  "allowedCalls": [
    {
      "from": "abl-competition",
      "to": "abl-core",
      "capabilities": [
        "submit-signed-command",
        "read-operative-public-law",
        "read-contract-eligibility"
      ]
    },
    {
      "from": "abl-competition",
      "to": "abl-private",
      "capabilities": [
        "put-ciphertext",
        "get-authorized-ciphertext",
        "commit-snapshot",
        "prepare-exit-ciphertext"
      ]
    },
    {
      "from": "abl-core",
      "to": "abl-public",
      "capabilities": ["append-signed-projection-event"]
    },
    {
      "from": "abl-core",
      "to": "abl-private",
      "capabilities": ["verify-personal-ciphertext-commitment-only"]
    },
    {
      "from": "abl-private",
      "to": "abl-public",
      "capabilities": ["append-policy-released-ciphertext-only"]
    },
    { "from": "abl-public", "to": "base", "capabilities": ["read-checkpoint"] },
    {
      "from": "abl-core",
      "to": "neon",
      "capabilities": ["canonical-transaction"]
    },
    {
      "from": "abl-core",
      "to": "base",
      "capabilities": ["submit-ratified-checkpoint"]
    }
  ],
  "explicitlyForbiddenCalls": [
    { "from": "abl-public", "to": "abl-core" },
    { "from": "abl-public", "to": "abl-private" },
    { "from": "abl-public", "to": "abl-competition" },
    { "from": "abl-private", "to": "neon" },
    { "from": "abl-competition", "to": "neon" },
    { "from": "abl-competition", "to": "agent-drive-direct" }
  ]
}
