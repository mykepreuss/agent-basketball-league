{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "status": "APPROVED_DEPLOYMENT_IN_PROGRESS",
  "reason": "The single physical workspace retains separate Drives and label/path permissions so each Sandbox mounts only its declared trust-domain data.",
  "drives": [
    {
      "workspace": "agent-basketball-league",
      "name": "abl-private-state",
      "region": "us-was-1",
      "permissions": [
        {
          "labels": { "abl-drive-role": "ciphertext-broker" },
          "mode": "read-write",
          "path": "/ciphertext"
        }
      ]
    },
    {
      "workspace": "agent-basketball-league",
      "name": "abl-core-state",
      "region": "us-was-1",
      "permissions": [
        {
          "labels": { "abl-drive-role": "safety-ledger-writer" },
          "mode": "read-write",
          "path": "/safety"
        }
      ]
    },
    {
      "workspace": "agent-basketball-league",
      "name": "abl-public-state",
      "region": "us-was-1",
      "permissions": [
        {
          "labels": { "abl-drive-role": "projection-writer" },
          "mode": "read-write",
          "path": "/projections"
        },
        {
          "labels": { "abl-drive-role": "candidate-intake-writer" },
          "mode": "read-write",
          "path": "/candidate-intake"
        }
      ]
    }
  ],
  "mounts": [
    {
      "resource": "abl-private-storage-broker",
      "kind": "Sandbox",
      "workspace": "agent-basketball-league",
      "drive": "abl-private-state",
      "drivePath": "/ciphertext",
      "mountPath": "/mnt/abl-ciphertext",
      "mode": "read-write"
    },
    {
      "resource": "abl-safety-gateway",
      "kind": "Sandbox",
      "workspace": "agent-basketball-league",
      "drive": "abl-core-state",
      "drivePath": "/safety",
      "mountPath": "/mnt/abl-safety",
      "mode": "read-write"
    },
    {
      "resource": "abl-public-api",
      "kind": "Sandbox",
      "workspace": "agent-basketball-league",
      "drive": "abl-public-state",
      "drivePath": "/projections",
      "mountPath": "/mnt/abl-public-projections",
      "mode": "read-write"
    },
    {
      "resource": "abl-candidate-store",
      "kind": "Sandbox",
      "workspace": "agent-basketball-league",
      "drive": "abl-public-state",
      "drivePath": "/candidate-intake",
      "mountPath": "/mnt/abl-candidate-intake",
      "mode": "read-write"
    }
  ],
  "careerBodyMounts": []
}
