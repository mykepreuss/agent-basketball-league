{
  "name": "@abl/genesis",
  "version": "0.0.0-pre-genesis",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@abl/recognition": "workspace:*",
    "@abl/schemas": "workspace:*",
    "solc": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
